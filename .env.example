# Which backend the app talks to. Anything other than "supabase" — including
# leaving it out — runs the in-memory demo repo from src/data/seed.ts: no login,
# no network, a role switcher in the header. Good for UI work and demos.
#
# "supabase" talks to the REAL database with real personal data. There is no
# staging instance. Read CLAUDE.md before switching this on.
VITE_DATA_BACKEND=mock

# Supabase (gcpdev) — copy to .env.local and fill from get_supabase_credentials_claude.
# .env.local is gitignored; never commit real credentials.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Basis-URL der Edge Functions (Cloud Run — liefert deploy_edge_function; im
# CI-Build kommt sie aus der Repo-Variable VITE_FUNCTIONS_URL). Öffentlich
# unkritisch, Login/Rolle erzwingt die Function selbst. Fehlt die Variable,
# bleibt der Transkript-Import auf dem manuellen Gemini-Weg.
VITE_FUNCTIONS_URL=

# Server-only (edge functions / admin tasks). NEVER expose to the client / never VITE_-prefix:
# SUPABASE_SERVICE_ROLE_KEY=
